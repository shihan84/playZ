// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Post {
  id        String   @id @default(cuid())
  title     String
  content   String?
  published Boolean  @default(false)
  authorId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PlayoutWorkflow {
  id          String   @id @default(cuid())
  channelId   String
  name        String
  description String?
  nodes       String
  connections String
  isActive    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model PlayoutSchedule {
  id            String   @id @default(cuid())
  channelId     String
  name          String
  description   String?
  items         String
  totalDuration Int      @default(0)
  scheduledAt   DateTime?
  isActive      Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model CGTemplate {
  id        String   @id @default(cuid())
  channelId String?
  name      String
  type      String
  html      String
  css       String
  isVisible Boolean  @default(true)
  layer     Int      @default(1)
  isGlobal  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SCTE35Marker {
  id            String   @id @default(cuid())
  channelId     String
  name          String
  signalType    String
  prerollFrames Int      @default(30)
  duration      Int      @default(60)
  autoReturn    Boolean  @default(true)
  description   String?
  tier          String   @default("national")
  position      Int      @default(0)
  base64Output  String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model PlayoutLog {
  id          String   @id @default(cuid())
  channelId   String?
  action      String
  details     String?
  status      String
  timestamp   DateTime @default(now())
  metadata    String?
}

model Channel {
  id                String   @id @default(cuid())
  name              String
  description       String?
  callSign          String?  @unique
  isActive          Boolean  @default(true)
  status            String   @default("idle")
  currentProgram    String?
  currentEvent      String?
  currentTime       Int      @default(0)
  totalDuration     Int      @default(0)
  frameRate         Int      @default(30)
  resolution        String   @default("1920x1080")
  aspectRatio       String   @default("16:9")
  audioChannels     Int      @default(2)
  audioSampleRate   Int      @default(48000)
  videoCodec        String   @default("h264")
  audioCodec        String   @default("aac")
  bitrate           Int      @default(5000000)
  priority          Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model StreamOutput {
  id              String   @id @default(cuid())
  channelId       String
  name            String
  protocol        String
  url             String
  streamKey       String?
  backupUrl       String?
  isPrimary       Boolean  @default(false)
  isBackup        Boolean  @default(false)
  isActive        Boolean  @default(true)
  status          String   @default("idle")
  lastStreamTime  DateTime?
  bitrate         Int?
  fps             Int?
  resolution      String?
  codec           String?
  metadata        String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model ChannelSchedule {
  id           String   @id @default(cuid())
  channelId    String
  scheduleId   String
  dayOfWeek    Int      @default(0)
  startTime    String
  endTime      String
  repeat       Boolean  @default(true)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}